{
  "apiVersion": "pilotswarm.dev/v1",
  "catchAll": null,
  "contracts": {
    "Progress@1": {
      "schema": "contract.Progress.v1"
    }
  },
  "description": null,
  "initial": "listen",
  "initialInput": null,
  "inputsSchema": null,
  "irVersion": 1,
  "limits": {
    "maxNodeExecutions": 1000
  },
  "name": "legacy-single-receive",
  "nodes": {
    "done": {
      "description": null,
      "hasOutput": true,
      "id": "done",
      "outcome": "succeeded",
      "output": "${input}",
      "outputSchema": null,
      "summary": null,
      "type": "terminal"
    },
    "failed": {
      "description": null,
      "hasOutput": true,
      "id": "failed",
      "outcome": "failed",
      "output": "${runtime.error}",
      "outputSchema": null,
      "summary": null,
      "type": "terminal"
    },
    "listen": {
      "contract": "Progress@1",
      "correlate": null,
      "description": null,
      "from": null,
      "hasInput": false,
      "id": "listen",
      "input": null,
      "mode": "receive",
      "next": {
        "elapsed": "done",
        "failure": "failed",
        "received": "done"
      },
      "type": "messaging",
      "waitSeconds": 30
    }
  },
  "outputSchema": null,
  "schemaDefs": {
    "contract.Progress.v1": {
      "properties": {
        "step": {
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "version": "1.0.0"
}
