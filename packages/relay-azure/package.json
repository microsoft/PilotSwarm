{
    "name": "pilotswarm-relay-azure",
    "version": "0.0.1",
    "private": true,
    "description": "Azure Relay Hybrid Connections provider for pilotswarm-relay-core, plus the pilotswarm-relay command built on it.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "bin": {
        "pilotswarm-relay": "./dist/cli.js",
        "pilotswarm-relay-portal-standin": "./dist/portal-standin.js"
    },
    "scripts": {
        "build": "tsc",
        "test:live": "node --env-file=$HOME/.config/pilotswarm-relay/spike.env --test test/azure-live.test.mjs",
        "relay": "node dist/cli.js",
        "demo": "node --env-file=$HOME/.config/pilotswarm-relay/spike.env --env-file-if-exists=../../.env dist/demo.js",
        "portal": "node --env-file=$HOME/.config/pilotswarm-relay/spike.env dist/portal-standin.js"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "@github/copilot-sdk": "1.0.13",
        "pilotswarm-relay-core": "0.0.1",
        "ws": "^8.19.0",
        "@azure/identity": "^4.13.1"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    },
    "license": "MIT"
}
