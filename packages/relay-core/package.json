{
    "name": "pilotswarm-relay-core",
    "version": "0.0.1",
    "private": true,
    "description": "Relay core: run commands on machines outside Kubernetes. The same for every relay service; services plug in as providers.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./testing/contract": "./test/contract.mjs"
